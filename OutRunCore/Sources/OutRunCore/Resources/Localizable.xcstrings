        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altitude data is not available on this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de altitud no están disponibles en este dispositivo."
          }
        }
      }
    },
    "altitude_service_error_authorization_denied" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höhendaten können aufgrund abgelehnter Berechtigung nicht abgerufen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altitude data cannot be received due to denied authorization."
          }
        },
