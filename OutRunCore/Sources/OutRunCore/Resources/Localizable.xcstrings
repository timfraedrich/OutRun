    "altitude_service_error_authorization_restricted" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höhendaten können aufgrund von Systemeinstellungen nicht abgerufen werden. Diese Einstellung kann in der iOS Einstellungen App unter \"Datenschutz & Sicherheit > Bewegung & Fitness\" geändert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altitude data cannot be received due to system settings. You can change this in the iOS Settings app under \"Privacy & Security > Motion & Fitness\"."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altitude data cannot be received due to system settings. You can change this in the iOS Settings app under \"Privacy & Security > Motion & Fitness\"."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pueden recibir datos de altitud debido a la configuración del sistema. Puedes cambiarlo en la app de Ajustes de iOS en \"Privacidad y seguridad > Movimiento y actividad física\"."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données d'altitude ne peuvent pas être reçues en raison des réglages système. Vous pouvez modifier cela dans l'app Réglages iOS sous « Confidentialité et sécurité > Activité physique »."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoogtegegevens kunnen niet worden ontvangen vanwege systeeminstellingen. Je kunt dit wijzigen in de iOS Instellingen-app onder \"Privacy en beveiliging > Beweging en conditie\"."
          }
        }
      }
    },
