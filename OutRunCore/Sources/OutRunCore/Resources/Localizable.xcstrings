    "core_error_newer_workout_version_exists" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Workout konnte nicht gespeichert werden, da bereits eine neuere Version in der Datenbank vorhanden ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The workout could not be saved as a newer version already exists in the database."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The workout could not be saved as a newer version already exists in the database."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El entrenamiento no se pudo guardar porque ya existe una versión más reciente en la base de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'entraînement n'a pas pu être sauvegardé car une version plus récente existe déjà dans la base de données."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De training kon niet worden opgeslagen omdat er al een nieuwere versie in de database bestaat."
          }
        }
      }
    },
    "core_error_not_initialized" : {
      "localizations" : {
        "de" : {
