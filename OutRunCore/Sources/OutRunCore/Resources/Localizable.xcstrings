    "altitude_service_error_authorization_denied" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höhendaten können aufgrund abgelehnter Berechtigung nicht abgerufen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altitude data cannot be received due to denied authorization."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altitude data cannot be received due to denied authorisation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pueden recibir datos de altitud porque el permiso fue denegado."
