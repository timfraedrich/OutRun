      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt bereits einen Nutzer in der Datenbank. Nur ein einzelner Nutzer wird unterstützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There already is a user present in the database. Only one user is supported."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya existe un usuario en la base de datos. Solo se admite un usuario."
          }
