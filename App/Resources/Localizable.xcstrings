        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Santé ne demande les autorisations qu'une seule fois. Ensuite, elles ne peuvent être consultées et modifiées que dans l'app Santé."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
