    "legacy_migration_profile_message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben übernommen, was möglich war. Ergänze den Rest, wenn du möchtest – oder überspringe es und erledige es später in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We brought over what we could. Add the rest if you’d like — or skip and do it later in Settings."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We brought over what we could. Add the rest if you’d like — or skip and do it later in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemos traído todo lo que hemos podido. Añade el resto si quieres, u omítelo y hazlo más tarde en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous avons repris tout ce que nous pouvions. Complétez le reste si vous le souhaitez, ou ignorez cette étape et faites-le plus tard dans les Réglages."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We hebben overgenomen wat we konden. Vul de rest aan als je wilt, of sla dit over en doe het later in Instellingen."
          }
        }
      }
    },
