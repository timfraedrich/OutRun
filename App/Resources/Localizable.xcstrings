    "permission_apple_health_denied_resolution" : {
      "comment" : "Instructions for changing Apple Health permissions, which cannot be changed from within the app.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne die Health-App, tippe auf dein Profilbild und wähle dann „Apps und Dienste“ › OutRun, um die Daten zu erlauben, die du synchronisieren möchtest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the Health app, tap your profile picture, then choose Apps & Services › OutRun and allow the data you want to sync."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the Health app, tap your profile picture, then choose Apps & Services › OutRun and allow the data you want to sync."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre la app Salud, toca tu foto de perfil y elige «Apps y servicios» › OutRun para permitir los datos que quieras sincronizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre l'app Santé, touche ta photo de profil, puis choisis « Apps et services » › OutRun et autorise les données que tu souhaites synchroniser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open de Gezondheid-app, tik op je profielfoto en kies ‘Apps en diensten’ › OutRun om toegang te geven tot de gegevens die je wilt synchroniseren."
          }
        }
      }
    },
    "permission_apple_health_limited_resolution" : {
      "comment" : "Instructions for reviewing partially granted Apple Health permissions.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Datentypen werden nicht mit OutRun geteilt. Öffne die Health-App, tippe auf dein Profilbild und wähle „Apps und Dienste“ › OutRun, um deine Auswahl zu überprüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some data types are not shared with OutRun. Open the Health app, tap your profile picture, then choose Apps & Services › OutRun to review your selection."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some data types are not shared with OutRun. Open the Health app, tap your profile picture, then choose Apps & Services › OutRun to review your selection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos tipos de datos no se comparten con OutRun. Abre la app Salud, toca tu foto de perfil y elige «Apps y servicios» › OutRun para revisar tu selección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains types de données ne sont pas partagés avec OutRun. Ouvre l'app Santé, touche ta photo de profil, puis choisis « Apps et services » › OutRun pour vérifier ta sélection."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige gegevenstypen worden niet met OutRun gedeeld. Open de Gezondheid-app, tik op je profielfoto en kies ‘Apps en diensten’ › OutRun om je selectie te bekijken."
          }
        }
      }
    },
    "permission_apple_health_reason" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Zugriff auf Apple Health kann OutRun deine aufgezeichneten Workouts exportieren und Workouts importieren, die von deiner Apple Watch oder anderen Apps aufgezeichnet wurden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Access to Apple Health lets OutRun export your recorded workouts and import workouts recorded by your Apple Watch or other apps."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Access to Apple Health lets OutRun export your recorded workouts and import workouts recorded by your Apple Watch or other apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a Apple Health permite a OutRun exportar tus entrenamientos grabados e importar los que hayan registrado tu Apple Watch u otras apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès à Apple Santé permet à OutRun d'exporter tes entraînements enregistrés et d'importer ceux enregistrés par ton Apple Watch ou d'autres apps."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met toegang tot Apple Health kan OutRun je opgenomen trainingen exporteren en trainingen importeren die zijn vastgelegd door je Apple Watch of andere apps."
          }
        }
      }
    },
    "permission_location_denied_resolution" : {
      "comment" : "Instructions for re-enabling the location permission from the iOS Settings app.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne die Einstellungen, tippe auf „Standort“ und wähle „Beim Verwenden der App“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings, tap Location and choose “While Using the App”."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings, tap Location and choose “While Using the App”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Ajustes, toca «Ubicación» y elige «Al usar la app»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre Réglages, touche « Position » et choisis « Lorsque l'app est active »."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Instellingen, tik op ‘Locatie’ en kies ‘Bij gebruik van de app’."
          }
        }
      }
    },
    "permission_location_limited_resolution" : {
      "comment" : "Instructions for enabling full location accuracy from the iOS Settings app.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne die Einstellungen, tippe auf „Standort“ und aktiviere „Genauer Standort“, sonst kann deine Route nicht genau aufgezeichnet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings, tap Location and turn on Precise Location, otherwise your route cannot be recorded accurately."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings, tap Location and turn on Precise Location, otherwise your route cannot be recorded accurately."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Ajustes, toca «Ubicación» y activa «Ubicación exacta»; de lo contrario, tu ruta no se puede registrar con precisión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre Réglages, touche « Position » et active « Position exacte », sinon ton itinéraire ne peut pas être enregistré précisément."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Instellingen, tik op ‘Locatie’ en schakel ‘Exacte locatie’ in, anders kan je route niet nauwkeurig worden vastgelegd."
          }
        }
      }
    },
    "permission_location_reason" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Standort wird verwendet, um Route, Distanz, Geschwindigkeit und Höhe eines Workouts aufzuzeichnen. Er wird nur während einer laufenden Aufzeichnung gelesen und verlässt dein Gerät nie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location is used to record the route, distance, speed and elevation of a workout. It is only read while a recording is in progress and never leaves your device."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location is used to record the route, distance, speed and elevation of a workout. It is only read while a recording is in progress and never leaves your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ubicación se usa para registrar la ruta, la distancia, la velocidad y la altitud de un entrenamiento. Solo se lee mientras hay una grabación en curso y nunca sale de tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta position est utilisée pour enregistrer l'itinéraire, la distance, la vitesse et l'altitude d'un entraînement. Elle n'est lue que pendant un enregistrement en cours et ne quitte jamais ton appareil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je locatie wordt gebruikt om de route, afstand, snelheid en hoogte van een training vast te leggen. Ze wordt alleen gelezen tijdens een lopende opname en verlaat je apparaat nooit."
          }
        }
      }
    },
    "permission_motion_and_fitness_denied_resolution" : {
      "comment" : "Instructions for re-enabling the motion and fitness permission from the iOS Settings app.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne die Einstellungen und aktiviere „Bewegung & Fitness“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings and turn on Motion & Fitness."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings and turn on Motion & Fitness."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Ajustes y activa «Movimiento y forma física»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre Réglages et active « Mouvement et forme »."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Instellingen en schakel ‘Beweging en fitness’ in."
          }
        }
      }
    },
    "permission_motion_and_fitness_reason" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Bewegungs- und Fitnessdaten kann OutRun das Barometer deines Geräts nutzen, um Höhenänderungen deutlich genauer aufzuzeichnen als mit GPS allein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motion & fitness data lets OutRun use the barometer of your device to record elevation changes far more precisely than GPS alone."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Motion & fitness data lets OutRun use the barometer of your device to record elevation changes far more precisely than GPS alone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de movimiento y forma física permiten a OutRun usar el barómetro de tu dispositivo para registrar los cambios de altitud con mucha más precisión que solo con el GPS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données de mouvement et de forme permettent à OutRun d'utiliser le baromètre de ton appareil pour enregistrer les variations d'altitude bien plus précisément qu'avec le GPS seul."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met beweging- en fitnessgegevens kan OutRun de barometer van je apparaat gebruiken om hoogteverschillen veel nauwkeuriger vast te leggen dan met gps alleen."
          }
        }
      }
    },
