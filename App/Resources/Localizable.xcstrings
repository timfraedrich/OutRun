    "workout_detail_delete_confirmation_message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bist du dir sicher, dass du dieses Workout löschen willst? Wenn es mit dieser App aufgenommen wurde, wird es auch auf verbundenen Diensten, wie Apple Health, gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to delete this workout? If the workout was recorded in this app, it will also be removed from synced services such as Apple Health."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to delete this workout? If the workout was recorded in this app, it will also be removed from synced services such as Apple Health."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Seguro que quieres eliminar este entrenamiento? Si se grabó con esta aplicación, también se eliminará de los servicios sincronizados, como Apple Health."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es-tu sûr de vouloir supprimer cet entraînement ? S'il a été enregistré avec cette application, il sera également supprimé des services synchronisés, tels qu'Apple Health."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weet je zeker dat je deze training wilt verwijderen? Als deze met deze app is opgenomen, wordt hij ook verwijderd van gesynchroniseerde diensten, zoals Apple Health."
          }
        }
      }
    },
