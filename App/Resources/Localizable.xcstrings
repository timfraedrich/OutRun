    "legacy_migration_privacy_message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch wenn sich die App stark verändert hat, unser Einsatz für Datenschutz ist geblieben. Mit OutRun behältst du die Kontrolle über deine Daten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even though the app changed quite a bit, our commitment to privacy did not. With OutRun you stay in control of your data."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even though the app changed quite a bit, our commitment to privacy did not. With OutRun you stay in control of your data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aunque la app ha cambiado bastante, nuestro compromiso con la privacidad sigue intacto. Con OutRun, tú tienes el control de tus datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même si l’app a beaucoup changé, notre engagement envers la confidentialité reste le même. Avec OutRun, vous gardez le contrôle de vos données."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoewel de app flink is veranderd, is onze inzet voor privacy gebleven. Met OutRun houd je zelf de controle over je gegevens."
          }
        }
      }
    },
