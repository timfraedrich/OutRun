    "backup_export_description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportiere deine Workoutdaten zur sicheren Aufbewahrung und um sie später wiederherzustellen. Das Backup wird als .zip-Archiv mit einer .json-Datei für jedes Workout gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export your workout data for safe keeping and to restore it later. The backup will be saved as a .zip archive with .json files for each workout."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export your workout data for safe keeping and to restore it later. The backup will be saved as a .zip archive with .json files for each workout."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta tus datos de entrenamiento para guardarlos de forma segura y restaurarlos más adelante. La copia de seguridad se guardará como un archivo .zip con archivos .json por cada entrenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportez vos données d'entraînement pour les conserver en sécurité et les restaurer ultérieurement. La sauvegarde sera enregistrée sous forme d'archive .zip avec des fichiers .json pour chaque entraînement."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporteer je trainingsgegevens voor veilige opslag en om ze later te herstellen. De back-up wordt opgeslagen als een .zip-archief met .json-bestanden voor elke training."
          }
        }
      }
    },
