    "workout_edit_route_truncation_confirmation_message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast das Start- oder Enddatum so bearbeitet, dass Teile der Route außerhalb des Zeitrahmens des Workouts fallen. Möchtest du die Route zuschneiden, sodass sie passt oder sie wie sie ist behalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You adjusted the start or end date such that parts of the route fall outside the time frame of this workout. Do you want to truncate the route to fit or keep it as it is?"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You adjusted the start or end date such that parts of the route fall outside the time frame of this workout. Do you want to truncate the route to fit or keep it as it is?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustaste la fecha de inicio o fin de modo que partes de la ruta quedan fuera del marco temporal de este entrenamiento. ¿Quieres recortar la ruta para que encaje o mantenerla tal como está?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez ajusté la date de début ou de fin de sorte que certaines parties du parcours se trouvent en dehors de la période de cet entraînement. Souhaitez-vous tronquer le parcours pour qu'il corresponde ou le conserver tel quel ?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt de start- of einddatum zo aangepast dat delen van de route buiten het tijdsbestek van deze workout vallen. Wil je de route inkorten zodat deze past of behouden zoals deze is?"
          }
        }
      }
    },
    "workout_edit_route_truncation_confirmation_title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchtest du die Route zuschneiden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
