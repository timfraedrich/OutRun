    "recording_permissions_notice_message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufzeichnung von Workouts beruht auf Sensordaten, die iOS durch Berechtigungen schützt. Sieh nach, wofür die einzelnen Berechtigungen verwendet werden, und erteile die, mit denen du einverstanden bist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Workout recording relies on sensor data that iOS protects behind permissions. Review what each one is used for and grant the permissions you consent to."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Workout recording relies on sensor data that iOS protects behind permissions. Review what each one is used for and grant the permissions you consent to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación de entrenamientos se basa en datos de sensores que iOS protege mediante permisos. Consulta para qué se usa cada uno y concede los permisos con los que estés de acuerdo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'enregistrement des entraînements repose sur des données de capteurs qu'iOS protège par des autorisations. Consulte l'usage de chacune et accorde celles auxquelles tu consens."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het opnemen van trainingen berust op sensorgegevens die iOS met toestemmingen beschermt. Bekijk waarvoor elke toestemming wordt gebruikt en geef de toestemmingen waarmee je instemt."
          }
        }
      }
    },
    "recording_permissions_notice_required_hint" : {
