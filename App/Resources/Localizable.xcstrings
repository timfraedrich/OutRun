    "reset_app_confirmation_message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bist du sicher, dass du die App zurücksetzen möchtest? Dadurch werden alle lokal gespeicherten Daten einschließlich deiner Workouts und persönlichen Informationen gelöscht. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to reset the app. This will delete all data saved locally including your workouts and personal information. This action connot be undone."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to reset the app. This will delete all data saved locally including your workouts and personal information. This action connot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Estás seguro de que quieres restablecer la app? Esto eliminará todos los datos guardados localmente, incluyendo tus entrenamientos e información personal. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Êtes-vous sûr de vouloir réinitialiser l'app ? Toutes les données enregistrées localement, y compris vos entraînements et vos informations personnelles, seront supprimées. Cette action est irréversible."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weet je zeker dat je de app wilt herstellen? Alle lokaal opgeslagen gegevens, inclusief je trainingen en persoonlijke informatie, worden verwijderd. Deze actie kan niet ongedaan worden gemaakt."
          }
        }
      }
