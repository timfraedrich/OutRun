    "legacy_migration_new_look_message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben eine komplett neue Oberfläche gebaut, die sich auf der neuesten iOS-Version wie zu Hause fühlt. Die App ist aufgeräumter und zeigt noch mehr Details auf einen Blick."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We built a completely new interface that feels at home on the latest version of iOS. The app got cleaner and provides even more details at a glance."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We built a completely new interface that feels at home on the latest version of iOS. The app got cleaner and provides even more details at a glance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hemos creado una interfaz completamente nueva que se siente como en casa en la última versión de iOS. La app es más limpia y muestra aún más detalles de un vistazo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous avons conçu une interface entièrement nouvelle, parfaitement à sa place sur la dernière version d’iOS. L’app est plus épurée et affiche encore plus de détails en un coup d’œil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We hebben een volledig nieuwe interface gebouwd die zich thuis voelt op de nieuwste versie van iOS. De app is overzichtelijker en toont nog meer details in één oogopslag."
          }
        }
      }
    },
    "legacy_migration_new_look_title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von Grund auf neu gestaltet"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Designed from scratch"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Designed from scratch"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diseñada desde cero"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entièrement repensée"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volledig opnieuw ontworpen"
          }
        }
      }
    },
    "legacy_migration_performance_message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da wir jede Funktion von Grund auf neu gedacht haben, stand Leistung für uns an erster Stelle. Das Ergebnis ist eine App, die sich selbst bei stundenlangen Trainings flott anfühlt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With every feature rethought from scratch, we prioritized performance above all. The result is an app that feels snappy even when dealing with hour long workouts."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With every feature rethought from scratch, we prioritised performance above all. The result is an app that feels snappy even when dealing with hour long workouts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al replantear cada función desde cero, dimos prioridad absoluta al rendimiento. El resultado es una app que responde con agilidad incluso con entrenamientos de varias horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En repensant chaque fonctionnalité de zéro, nous avons fait de la performance notre priorité absolue. Résultat : une app réactive, même avec des entraînements de plusieurs heures."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omdat we elke functie opnieuw hebben bedacht, stond prestatie voorop. Het resultaat is een app die vlot aanvoelt, zelfs bij trainingen van een uur of langer."
          }
        }
      }
    },
    "legacy_migration_performance_title" : {
      "localizations" : {
        "de" : {
