    "recording_permissions_footer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erforderliche Berechtigungen müssen erteilt werden, bevor ein Workout aufgezeichnet werden kann. Optionale Berechtigungen sind nicht nötig, verbessern aber die Qualität der aufgezeichneten Daten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Required permissions have to be granted before a workout can be recorded. Optional ones are not needed, but improve the quality of the recorded data."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Required permissions have to be granted before a workout can be recorded. Optional ones are not needed, but improve the quality of the recorded data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los permisos obligatorios deben concederse antes de poder grabar un entrenamiento. Los opcionales no son necesarios, pero mejoran la calidad de los datos registrados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les autorisations obligatoires doivent être accordées avant de pouvoir enregistrer un entraînement. Les autorisations facultatives ne sont pas nécessaires, mais améliorent la qualité des données enregistrées."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vereiste toestemmingen moeten zijn gegeven voordat je een training kunt opnemen. Optionele toestemmingen zijn niet nodig, maar verbeteren de kwaliteit van de vastgelegde gegevens."
          }
        }
      }
    },
