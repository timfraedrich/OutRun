    "health_permissions_footer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health fragt Berechtigungen nur einmal ab. Danach können sie nur noch in der Health-App überprüft und geändert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health asks for permissions only once. Afterwards they can only be reviewed and changed in the Health app."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health asks for permissions only once. Afterwards they can only be reviewed and changed in the Health app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health solo pide los permisos una vez. Después solo se pueden revisar y cambiar en la app Salud."
