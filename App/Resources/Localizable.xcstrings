    "backup_import_success_message_%lld_total_%lld_successfull_%lld_skipped_%lld_failed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von den %1$lld Workouts im ausgewählten Backup wurden %2$lld erfolgreich importiert, %3$lld übersprungen und %4$lld konnten nicht importiert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Of the %1$lld workouts in the provided backup, %2$lld were successfully imported, %3$lld were skipped, and %4$lld failed to import."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
