    "NSMotionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App braucht bewegungsbezogene Trackingberechtigung, um Daten wie Schritte aufzuzeichnen"
