{
  "sourceLanguage" : "en",
  "strings" : {
    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OutRun liest deine Workouts aus der Health-App, um Workouts anderer Apps und Geräte zu importieren und synchronisierte Workouts aktuell zu halten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OutRun reads your workouts from the Health app to import workouts recorded with other apps and devices and to keep synced workouts up to date."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OutRun reads your workouts from the Health app to import workouts recorded with other apps and devices and to keep synced workouts up to date."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OutRun lee tus entrenamientos de la app Salud para importar los registrados con otras apps y dispositivos y mantener actualizados los sincronizados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OutRun lit vos entraînements dans l’app Santé afin d’importer ceux enregistrés par d’autres apps et appareils et de maintenir à jour les entraînements synchronisés."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OutRun leest je trainingen uit de Gezondheid-app om trainingen van andere apps en apparaten te importeren en gesynchroniseerde trainingen actueel te houden."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OutRun speichert deine aufgezeichneten Workouts in der Health-App, damit sie dort und in anderen Apps verfügbar sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OutRun saves your recorded workouts to the Health app so they are available there and in other apps."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OutRun saves your recorded workouts to the Health app so they are available there and in other apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OutRun guarda tus entrenamientos registrados en la app Salud para que estén disponibles allí y en otras apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OutRun enregistre vos entraînements dans l’app Santé afin qu’ils y soient disponibles ainsi que dans d’autres apps."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OutRun bewaart je opgenomen trainingen in de Gezondheid-app, zodat ze daar en in andere apps beschikbaar zijn."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App braucht deinen Standort, um deine Läufe aufzuzeichnen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app needs your location to track workouts"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app needs your location to track workouts"
          }
