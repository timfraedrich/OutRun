            "state" : "translated",
            "value" : "Esta aplicación necesita tu ubicación para realizar un seguimiento de los entrenamientos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette application a besoin de votre emplacement pour suivre les entraînements"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze app heeft je locatie nodig om trainingen te volgen"
          }
        }
