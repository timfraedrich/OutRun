"Settings.DeleteAll.Confirmation.Title" = "எல்லாவற்றையும் நீக்கவா?";
"Settings.DeleteAll.Confirmation.Message" = "இந்த பயன்பாட்டின் மூலம் சேமிக்கப்பட்ட அனைத்து தரவுகளையும் நீக்க விரும்புகிறீர்களா? நீங்கள் பதிவுசெய்த எந்தவொரு உடற்பயிற்சிகளும், நீங்கள் உருவாக்கிய அனைத்து அமைப்புகளும் இதில் அடங்கும். ஆப்பிள் எல்த் காப்புப் பிரதி எடுக்காவிட்டால் எந்தவொரு வொர்க்அவுட் தரவை மீட்டெடுக்க முடியாது, மேலும் உங்கள் அமைப்புகள் நிரந்தரமாக இழக்கப்படும்.";
