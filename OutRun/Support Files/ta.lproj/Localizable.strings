"Settings.RecordingPreferences.Message" = "ஒரு வொர்க்அவுட்டைப் பதிவுசெய்யும் போது நீங்கள் எந்தவிதமான செயலிழப்புகளையும் அல்லது இதே போன்ற நடத்தைகளையும் அனுபவிக்க வேண்டுமானால், நீங்கள் 'சோ வரைபடத்தை' அணைக்க முயற்சிக்க வேண்டும், ஏனென்றால் இந்த செயலிழப்புகளில் பெரும்பாலானவை வரைபடத்துடன் தொடர்புடைய இடங்களில் அதிக ஆற்றல் பெறும் இடங்களில் அறியப்படுகின்றன.\n\n விரைவு காட்டப்படும் வேகத்தைக் காண்பிப்பதற்கு பதிலாக 'காட்சி விரைவு' இயக்கப்பட்டிருந்தால். 'காட்சி ரோலிங் விரைவு' வேகத்தில் இருக்க வேண்டும் அல்லது காட்டப்படும் வேகத்தில் இருக்க வேண்டும், இது கடைசி கிலோமீட்டரின் சராசரியாக இருக்க வேண்டும், இல்லையென்றால் தற்போதைய விரைவு அல்லது மொத்த விரைவு காட்டப்படுகிறது.";
