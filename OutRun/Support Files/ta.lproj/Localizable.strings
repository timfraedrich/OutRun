"Setup.Permissions.Message" = "எங்கள் சேவைகளை உங்களுக்கு வழங்க விரும்புவதால், இருப்பிட சேவைகள் போன்ற சில பநிஇ களுக்கு எங்களுக்கு அணுகல் தேவை அல்லது நீங்கள் ஆப்பிள் எல்த் உடன் ஒத்திசைக்க விரும்பினால், அந்த சேவையைப் படித்து எழுதவும்.";
