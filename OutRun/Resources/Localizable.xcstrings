    "backup_import_description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importiere ein von dieser App erstelltes Backup. Die App akzeptiert .zip-Archive und die alten .orbup-Dateien. Bereits in der App vorhandene Daten werden nicht überschrieben oder gelöscht. Wird ein veraltetes Workout importiert, wird es übersprungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import a backup created by this app. The app accepts .zip archives and the old .orbup files. Data already existing in the app will not be overwritten or removed. If you import an outdated workout, it will be skipped."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import a backup created by this app. The app accepts .zip archives and the old .orbup files. Data already existing in the app will not be overwritten or removed. If you import an outdated workout, it will be skipped."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa una copia de seguridad creada por esta app. La aplicación acepta archivos .zip y los archivos .orbup antiguos. Los datos ya existentes en la app no serán sobreescritos ni eliminados. Si importas un entrenamiento desactualizado, se omitirá."
          }
        }
      }
    },
    "backup_import_export_running_message" : {
