    "NSHealthShareUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App braucht Zugriff auf deine Health-Daten, um die erstellten Workouts zu speichern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app needs access to your health data to save workouts constructed by this app"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app needs access to your health data to save workouts constructed by this app"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta aplicación necesita acceso a sus datos de salud para guardar los entrenamientos construidos por esta aplicación"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette application a besoin d'accéder à vos données de santé pour enregistrer les entraînements créés par cette application"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze app heeft toegang nodig tot je gezondheidsgegevens om de gemaakte trainingen op te slaan"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App braucht Zugriff auf deine Health-Daten um gespeicherte Workouts auszulesen und gegebenenfalls zu korrigieren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
